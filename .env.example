# Copy to .env (`make env`) and fill in real values before deploying.
# .env is read automatically by docker compose and is git-ignored.

# ---------------------------------------------------------------- database --
POSTGRES_USER=chatters
POSTGRES_PASSWORD=change_me
POSTGRES_DB=messenger

# ----------------------------------------------------------------- backend --
# REQUIRED. Signs login tokens. The backend refuses to start in production
# without it. Generate one with:  openssl rand -base64 48
JWT_SECRET=

# Extra browser origins allowed to call the API, comma separated. Same-origin
# requests are always allowed, so leave this empty unless the SPA is served
# from a different hostname than the API.
ALLOWED_ORIGINS=

# Largest accepted upload, in bytes. Keep in step with client_max_body_size in
# frontend/nginx.conf (currently 20M).
MAX_UPLOAD_BYTES=20971520

# ------------------------------------------------------------- first admin --
# Creates this administrator on boot, or promotes the account if it already
# exists. Safe to leave set: it never overwrites an existing password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_too
ADMIN_EMAIL=admin@example.com

# ------------------------------------------------ push notifications (PWA) --
# Optional. Without these the app works normally but cannot notify a closed
# tab. Generate a pair with:  make vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# -------------------------------------------------------------------- host --
# Port nginx binds on the host.
HTTP_PORT=80
