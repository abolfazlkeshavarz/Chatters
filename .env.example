# Copy to .env (`make env`) and fill in real values before deploying.
# .env is read automatically by docker compose and is git-ignored.

# ---------------------------------------------------------------- database --
# The password may contain any characters, including spaces and the "+", "/"
# and "=" that `openssl rand -base64 32` produces - it is escaped correctly
# when the connection string is built.
POSTGRES_USER=chatters
POSTGRES_PASSWORD=change_me
POSTGRES_DB=messenger

# ----------------------------------------------------------------- backend --
# REQUIRED. Signs login tokens. The backend refuses to start in production
# without it. Generate one with:  openssl rand -base64 48
JWT_SECRET=

# Extra browser origins allowed to call the API, comma separated. Same-origin
# requests are always allowed, so leave this empty unless the SPA is served
# from a different hostname than the API.
ALLOWED_ORIGINS=

# Largest accepted upload, in bytes. Keep in step with client_max_body_size in
# frontend/nginx.conf (currently 20M).
MAX_UPLOAD_BYTES=20971520

# ------------------------------------------------------------- first admin --
# Creates this administrator on boot, or promotes the account if it already
# exists. Safe to leave set: it never overwrites an existing password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_too
ADMIN_EMAIL=admin@example.com

# ------------------------------------------------ push notifications (PWA) --
# Optional. Without these the app works normally but cannot notify a closed
# tab. Generate a pair with:  make vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# -------------------------------------------------------------------- host --
# Where the app container is published on the host.
#
# Loopback-only by default, because the intended layout is: nginx on the HOST
# owns 80/443 and routes each subdomain to its project's loopback port. Two
# reasons it is 127.0.0.1 and not 0.0.0.0:
#   - the app is meant to be reached only through nginx (TLS terminates there)
#   - Docker publishes ports by writing its own iptables rules, which UFW does
#     not filter, so 0.0.0.0 here would be internet-reachable even with the
#     firewall "blocking" it.
#
# Change the port (not the 127.0.0.1) if another project already uses 8082.
# scripts/setup-nginx.sh reads this to know what to proxy to.
HTTP_PORT=127.0.0.1:8082

# --------------------------------------------------------- build mirrors --
# Optional. Only matters while building the images (docker compose build) —
# not read at runtime. Leave empty to use the real registries. On a network
# where proxy.golang.org / registry.npmjs.org are slow or blocked (e.g. some
# Iranian ISPs), point these at a mirror instead — bootstrap-vps.sh offers to
# set them to https://package-mirror.liara.ir/... for you. GOSUMDB=off is
# normally paired with a Go proxy mirror, since the checksum database
# (sum.golang.org) is a separate service a mirror does not necessarily cover.
GOPROXY=
GOSUMDB=
NPM_REGISTRY=
