{
  "expo": {
    "name": "Chatters",
    "slug": "chatters-app",
    "scheme": "chatters",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0b0c10"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.chatters.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Chatters needs access to your photos so you can send images in chats and set a profile photo.",
        "NSCameraUsageDescription": "Chatters needs camera access so you can take a photo to send or use as your profile picture.",
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.chatters.app",
      "adaptiveIcon": {
        "backgroundColor": "#0b0c10"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.VIBRATE",
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-dev-client",
      [
        "expo-image-picker",
        {
          "photosPermission": "Chatters accesses your photos to let you share images and set a profile picture."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2f6fed"
        }
      ]
    ],
    "extra": {
      "apiBase": "https://chat.abolfazl.fun",
      "eas": {
        "projectId": "a02005db-60b7-4367-a3da-96b44fce22ab"
      }
    }
  }
}
