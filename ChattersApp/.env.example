# Copy to .env. Expo inlines EXPO_PUBLIC_* variables at bundle time, so this is
# the base URL the app talks to. No trailing slash. Must be reachable from a
# real device (a LAN IP or a public hostname, not "localhost").
#
# For EAS builds the value comes from eas.json's per-profile `env` block
# instead; this .env is for local `expo start` / `expo run:*`.
EXPO_PUBLIC_API_BASE=https://chatters.example.com
